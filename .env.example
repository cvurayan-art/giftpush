# Shopify Headless Storefront API Configuration
# Replace with your Shopify store domain and Storefront Access Token
# Storefront Access Token is safe for public client-side headless commerce.
# Never expose Shopify Admin API secrets in client-side code!
VITE_SHOPIFY_STORE_DOMAIN=checkout.presentpanic.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_shopify_storefront_access_token_here
VITE_SHOPIFY_API_VERSION=2024-07

# Optional: Shopify Webhook Secret for serverless validation on Vercel (/api/shopify)
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# ====================================================
# META ADS TRACKING (Browser Pixel + Server-Side CAPI)
# Strict 1:1 Deduplication: Prevents double-counting conversions
# ====================================================
# Meta Pixel ID (Used by both browser Pixel and server-side CAPI)
# Found in Meta Events Manager > Settings > Dataset ID / Pixel ID
VITE_META_PIXEL_ID=1569317721181690

# Meta Conversions API Access Token (Server-only secret for /api/meta-capi)
# Found in Meta Events Manager > Settings > Conversions API > Generate access token
META_ACCESS_TOKEN=your_meta_conversions_api_access_token_here

# Optional: Meta Events Manager Test Event Code (e.g. TEST12345) for live testing
META_TEST_EVENT_CODE=

# ====================================================
# GOOGLE ANALYTICS 4 (GA4)
# Full Enhanced E-commerce Tracking
# ====================================================
# Found in Google Analytics > Admin > Data Streams > Measurement ID
VITE_GA4_MEASUREMENT_ID=G-WEXQP7YJZ5
